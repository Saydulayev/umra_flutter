  "duaDetailTransLabel": "Anlam",
  "duaNiyyahUmrahTitle": "Umre Niyeti",
  "duaNiyyahUmrahTranslit": "Labbayka Allahumma bi-´umrah.",
  "duaNiyyahUmrahTrans": "Buyur, ey Allah'ım, huzurundayım, [umre yapmak üzere].",
  "duaIhramUmrahTitle": "İhram Duası (Umre)",
  "duaIhramUmrahTranslit": "Allahumma hazihi 'umrah, la riya'a fiha wa la sum'ah.",
  "duaIhramUmrahTrans": "Ey Allah'ım! Bu umre, gösteriş ve şöhret için değildir!",
  "duaTalbiyahTitle": "Telbiye",
  "duaTalbiyahTranslit": "Labbayka Allahumma labbayk! Labbayka laa shariika laka labbayka! Innal hamda wanni'mata laka wal mulk, laa shariika lak",
  "duaTalbiyahTrans": "Buyur Allah'ım, buyur! Buyur, Senin hiçbir ortağın yoktur! Buyur! Şüphesiz hamd, nimet ve mülk yalnızca Sana aittir! Senin hiçbir ortağın yoktur!",
  "duaMasjidEnterTitle": "Mescide Giriş Duası",
  "duaMasjidEnterTranslit": "Allahumma, solli ´ala Muhammadin wa sallim! Allahumma - ftah li abwaba rohmati-ka!",
  "duaMasjidEnterTrans": "Ey Allah'ım! Muhammed'e salât ve selam eyle! Ey Allah'ım! Bana rahmet kapılarını aç!",
  "duaConditionTitle": "Şartlandırma Duası",
  "duaConditionTranslit": "Allahumma mahilli haysu habastani",
  "duaConditionTrans": "Ey Allah'ım! Eğer beni bir şey engellerse, ihramdan çıkışım burada olsun.",
  "duaRabbanaTitle": "Köşeler Arası Dua",
  "duaRabbanaTranslit": "Rabbana, atina fid-dunya hasanatan wa fil-akhiroti hasanatan wa qina azaba-n-nar",
  "duaRabbanaTrans": "Rabbimiz! Bize dünyada iyilik ver, ahirette de iyilik ver ve bizi ateşin azabından koru!",
  "duaMaqamIbrahimTitle": "Makam-ı İbrahim Ayeti",
  "duaMaqamIbrahimTranslit": "Wa-ttahizu mim-maqomi Ibrohima musollya.",
  "duaMaqamIbrahimTrans": "Ve İbrahim'in makamını namaz yeri edinin (Bakara Suresi, 125. ayet).",
  "duaSafaAyahTitle": "Safa ve Merve Ayeti",
  "duaSafaAyahTranslit": "Inna Ssofaa wal-Marwata min sha'aaa'iril laah, faman hajjal Baita awi'tamaro falaa junaaha 'alaihi ayyatt´owwafa bihimaa, wa man tat´owwa'a hoyron fa-inna-LLAha Shakirun ´alim.",
  "duaSafaAyahTrans": "Şüphesiz ki Safa ve Merve, Allah'ın sembollerindendir. Kim Beytullah'a hac veya umre için gelirse, onların arasında yürüyerek geçmesinde kendisine bir günah yoktur. (Bakara Suresi, 158. Ayet).",
  "duaNabdauTitle": "Biz Allah'ın Başladığı ile Başlıyoruz",
  "duaNabdauTranslit": "Nabdau bima badaa-Llahu bihi",
  "duaNabdauTrans": "Biz, Allah'ın başladığı ile başlıyoruz.",
  "duaZikrSafaTitle": "Safa ve Merve Zikri",
  "duaZikrSafaTranslit": "Allahu Akbar! Allahu Akbar! Allahu Akbar! La ilaha illa-Llahu wahdahu la sharika lahu. Lahul mulku wa lahul hamdu yuhyi wa yumitu wa huwa 'ala kulli shay'in qodir. La ilaha illa-Llahu wahdahu la sharika lah, anjaza wa'dahu, wa nasaro 'abdahu, wa hazamal ahzaba wahdahu.",
  "duaZikrSafaTrans": "Allah en büyüktür! Allah en büyüktür! Allah en büyüktür! Allah'tan başka ilah yoktur, O tektir ve O'nun ortağı yoktur! O, vaadini yerine getirdi, kuluna yardım etti ve düşman birliklerini tek başına mağlup etti.",
  "duaRabbiIghfirTitle": "Sa'y Sırasında Dua",
  "duaRabbiIghfirTranslit": "Rabbi-ghfir wa rham, innaka anta a´azzul-akram",
  "duaRabbiIghfirTrans": "Ey Rabbim! Beni bağışla ve merhamet et! Şüphesiz Sen, en yüce ve en cömert olansın!",
  "duaMasjidExitTitle": "Mescidden Çıkış Duası",
  "duaMasjidExitTranslit": "Allahumma solli 'ala Muhammadin wa sallim! Allahumma, inni as'aluka min fadlika!",
  "duaMasjidExitTrans": "Ey Allah'ım! Muhammed'e salât ve selam eyle! Ey Allah'ım! Şüphesiz, Senin lütfunu diliyorum!",
  "duaNiyyahHajjTitle": "Hac Niyeti",
  "duaNiyyahHajjTrans": "Buyur, ey Allah'ım, huzurundayım, [hac yapmak üzere].",
  "duaIhramHajjTitle": "İhram Duası (Hac)",
  "duaArafatTitle": "Arafat Duası"
}
