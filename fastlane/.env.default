# Шаблон переменных окружения для Fastlane.
# Скопируй этот файл в fastlane/.env и заполни реальными значениями:
#   cp fastlane/.env.default fastlane/.env
# fastlane/.env в .gitignore — секреты никогда не попадут в git.
# Как получить каждое значение — см. docs/fastlane-setup.md

# ─── Android / Google Play ───
# Путь к JSON-ключу сервисного аккаунта с доступом к Google Play Console API.
GOOGLE_PLAY_JSON_KEY_PATH=fastlane/play-store-credentials.json

# ─── iOS / App Store Connect ───
# Apple ID (email), под которым зарегистрирован аккаунт в App Store Connect.
APPLE_ID=your-apple-id@example.com

# App Store Connect API Key (создаётся в App Store Connect -> Users and Access -> Keys)
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Путь к скачанному .p8 файлу ключа (относительно корня проекта)
ASC_KEY_FILEPATH=fastlane/AuthKey_XXXXXXXXXX.p8
